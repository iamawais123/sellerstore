# Firebase web app settings — Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# Copy this file to `.env` and fill it in. The storefront, admin console and super-admin console
# all read this one file (the two dashboards point their envDir here), so it is only set once.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Google Analytics only)
VITE_FIREBASE_MEASUREMENT_ID=

# Local testing against the Firebase emulators (`npm run emulators`) instead of the real project.
# VITE_FIREBASE_USE_EMULATOR=true

# Telegram alerts (admin console -> Telegram Alerts). These are read by the serverless functions in api/, not by
# the browser (no VITE_ prefix). On Vercel set them under Settings -> Environment Variables; here they are only
# for running `vercel dev` locally. See "Telegram alerts" in README.md.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# FIREBASE_SERVICE_ACCOUNT=
# ADMIN_DASHBOARD_URL=
