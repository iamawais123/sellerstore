{
  "name": "usellerstore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:admin": "npm run dev --prefix admin-dashboard",
    "dev:super-admin": "npm run dev --prefix super-admin-dashboard",
    "build:admin": "npm run build --prefix admin-dashboard",
    "build:super-admin": "npm run build --prefix super-admin-dashboard",
    "build:all": "npm run build && npm run build:admin && npm run build:super-admin && node scripts/merge-admin-build.js",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-usellerstore",
    "test:rules": "firebase emulators:exec --only firestore --project demo-usellerstore \"node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/shopData.flow.test.mjs tests/shopData.sync.test.mjs\""
  },
  "dependencies": {
    "firebase": "^10.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  }
}
